<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>arjuy_scaffold</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests/**" />
    <EmbeddedResource Include="Templates/check-conventions.py" LogicalName="check-conventions.py" />
    <EmbeddedResource Include="Templates/check-english-identifiers.py" LogicalName="check-english-identifiers.py" />
    <EmbeddedResource Include="Templates/verify-conventions.py" LogicalName="verify-conventions.py" />
    <EmbeddedResource Include="Templates/english-allowlist.txt" LogicalName="english-allowlist.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
  </ItemGroup>

</Project>
